# Токен бота от @BotFather
TOKEN=

# Подключение к БД (хост localhost — при запуске вне Docker;
# в docker-compose.yml переопределяется на postgres)
SQLALCHEMY_URL=postgresql+asyncpg://weather_db:CHANGE_ME@localhost:5432/weather_db

# Telegram ID главного администратора
SUPER_ADMIN_ID=

# ID админ-группы для уведомлений
ADMIN_GROUP_ID=

# IP сервера
SERVER_IP=

# Адрес NATS
NATS_URL=nats://localhost:4222

# Реквизиты контейнера PostgreSQL (используются docker-compose.yml)
POSTGRES_USER=weather_db
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=weather_db

# Час ежедневной рассылки по локальному времени города (необязательно, по умолчанию 7)
# SEND_HOUR=10

# Минимальное население для загрузки городов из GeoNames (необязательно, по умолчанию 1000)
# MIN_POPULATION=1000
