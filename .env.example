# Токен бота от @BotFather
TOKEN=

# Подключение к БД (хост localhost — при запуске вне Docker;
# в docker-compose.yml переопределяется на postgres)
SQLALCHEMY_URL=postgresql+asyncpg://weather_db:CHANGE_ME@localhost:5432/weather_db

# Telegram ID главного администратора
SUPER_ADMIN_ID=

# ID админ-группы для уведомлений
ADMIN_GROUP_ID=

# Username для кнопки поддержки в меню (без @). Пусто = кнопка скрыта
SUPPORT_USERNAME=

# IP сервера
SERVER_IP=

# Адрес NATS
NATS_URL=nats://localhost:4222

# Реквизиты контейнера PostgreSQL (используются docker-compose.yml)
POSTGRES_USER=weather_db
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=weather_db

# Час ежедневной рассылки по локальному времени города (необязательно, по умолчанию 7)
# SEND_HOUR=10

# Минимальное население для загрузки городов из GeoNames (необязательно, по умолчанию 1000)
# MIN_POPULATION=1000

# --- Необязательные тонкие настройки ---

# Хост/порт БД для сборки строки подключения (если SQLALCHEMY_URL не задан)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# NATS: максимум доставок задачи и время ожидания ack, секунд
# NATS_MAX_DELIVER=3
# NATS_ACK_WAIT_SECONDS=300

# Поиск города по геолокации: радиус и шаг сетки поиска, км / градусы
# GEO_SEARCH_RADIUS_KM=75
# GEO_SEARCH_DELTA_DEGREES=1.0

# Ретраи Open-Meteo при временных сбоях
# WEATHER_MAX_ATTEMPTS=3
# WEATHER_RETRY_DELAY_SECONDS=2
